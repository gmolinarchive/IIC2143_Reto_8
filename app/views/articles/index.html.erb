<h1>Articles</h1>

<p>Our blog has <%= Article.count %> articles and counting!</p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Title</th>
      <th>Author</th>
      <th>Category</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @articles.each do |article| %>
      <tr>
        <td><%= article.id %></td>
        <td><%= article.title %></td>
        <td><%= article.author %></td>
        <td><%= article.category %></td>
        <td>
          <%= link_to "View", article_path(article), class: "btn primary" %>
          <%= link_to "Update", edit_article_path(article), class: "btn secondary" %>
          <%= link_to "Delete", article_path(article),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                      class: "btn danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New Article", new_article_path, class: "btn primary" %>
<%= link_to "Most recent", recent_articles_path, class: "btn secondary" %>
